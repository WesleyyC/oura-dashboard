# Identity provider: chatgpt-sites or cloudflare-access.
AUTH_PROVIDER=
# Cloudflare Access only: exact team domain and application AUD tag.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
# Oura OAuth application credentials. Never commit nonempty values.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Distinct random 32-byte base64url keys.
OURA_TOKEN_ENCRYPTION_KEY=
SECURITY_RATE_LIMIT_KEY=
# Comma-separated owner emails. Treat as private PII.
OWNER_EMAIL_ALLOWLIST=
