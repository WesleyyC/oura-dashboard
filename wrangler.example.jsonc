{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oura-dashboard",
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "dashboard.example.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oura-dashboard",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "AUTH_PROVIDER": "cloudflare-access",
    "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "team-name.cloudflareaccess.com",
    "CLOUDFLARE_ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  }
}
